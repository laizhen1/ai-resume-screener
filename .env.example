# Ollama runs entirely on your computer and does not charge per token.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# If false, the app uses its built-in deterministic synthetic generator.
ENABLE_LOCAL_AI=true

# Optional reviewer-only local AI summary. It never changes the deterministic score.
ENABLE_LOCAL_AI_REVIEW=true
OLLAMA_REVIEW_MODEL=qwen3:4b

# Optional local semantic evidence. Pull nomic-embed-text in Ollama before enabling.
ENABLE_LOCAL_EMBEDDINGS=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Keep memory mode for the no-storage demo. Use postgres for the review workspace.
DATA_MODE=memory
DATABASE_URL=postgresql://resume:resume@127.0.0.1:5432/open_resume_lab

# Inline processing is the zero-infrastructure default. Redis mode uses npm run worker.
QUEUE_MODE=inline
REDIS_URL=redis://127.0.0.1:6379

# Authentication is disabled only for private local demos. Shared deployments must set this false.
AUTH_DISABLED=true
AUTH_USERNAME=admin
AUTH_ROLE=admin
AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate with: npm run auth:hash -- your-password
AUTH_PASSWORD_HASH=

# PNG/JPEG OCR runs locally. Configure an HTTP service accepting multipart `file` for scanned PDFs.
OCR_LANGUAGE=eng
OCR_ENDPOINT=

# Disable framework development/build telemetry for a fully quiet local setup.
NEXT_TELEMETRY_DISABLED=1
