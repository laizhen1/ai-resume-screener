# Ollama runs entirely on your computer and does not charge per token.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b

# If false, the app uses its built-in deterministic synthetic generator.
ENABLE_LOCAL_AI=true

# Core requirement extraction and scoring prefer this local Ollama model.
ENABLE_LOCAL_AI_ANALYSIS=true
OLLAMA_ANALYSIS_MODEL=deepseek-r1:7b
# Increase for slower local hardware; milliseconds.
OLLAMA_ANALYSIS_TIMEOUT_MS=180000
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_TOKENS=4096
# DeepSeek-R1 reasoning is enabled. Only the final answer is parsed/displayed.
OLLAMA_THINK=true
# Optional portable runtime and model cache paths for npm run llm:serve.
# OLLAMA_EXECUTABLE=C:/path/to/ollama.exe
# OLLAMA_MODELS=C:/path/to/model-cache

# Optional reviewer-only local AI summary. It never changes the deterministic score.
ENABLE_LOCAL_AI_REVIEW=true
OLLAMA_REVIEW_MODEL=deepseek-r1:7b

# Optional local semantic evidence. Pull nomic-embed-text in Ollama before enabling.
ENABLE_LOCAL_EMBEDDINGS=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional Sentence Transformers + cross-encoder + DeBERTa review and cited Q&A.
# Start services/model-service first; see its README. Never use NEXT_PUBLIC_ for these.
ENABLE_TRANSFORMER_ANALYSIS=false
MODEL_SERVICE_URL=http://127.0.0.1:8000
MODEL_SERVICE_TIMEOUT_MS=120000
MODEL_SERVICE_TOKEN=
# npm run models:setup accepts a Python 3.12 executable via MODEL_PYTHON.
# MODEL_VENV can relocate .venv outside OneDrive; HF_HOME relocates model weights.
# npm run dev:ml loads these settings for both Python and Next.js.
MODEL_DEVICE=cpu
MODEL_STARTUP_TIMEOUT_MS=1800000

# Set these in the Python model-service environment (Compose forwards them).
NER_MODEL=
EVIDENCE_MODEL=
EVIDENCE_THRESHOLD=0.8
RETRIEVAL_MODE=hybrid
RETRIEVAL_BACKEND=numpy
# Docker model-service only: rebuild after enabling the optional FAISS dependency.
INSTALL_FAISS=false

# Keep memory mode for the no-storage demo. Use postgres for the review workspace.
DATA_MODE=memory
DATABASE_URL=postgresql://resume:resume@127.0.0.1:5432/open_resume_lab

# Inline processing is the zero-infrastructure default. Redis mode uses npm run worker.
QUEUE_MODE=inline
REDIS_URL=redis://127.0.0.1:6379

# Authentication is disabled only for private local demos. Shared deployments must set this false.
AUTH_DISABLED=true
AUTH_USERNAME=admin
AUTH_ROLE=admin
AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate with: npm run auth:hash -- your-password
AUTH_PASSWORD_HASH=

# PNG/JPEG OCR runs locally. Configure an HTTP service accepting multipart `file` for scanned PDFs.
OCR_LANGUAGE=eng
OCR_ENDPOINT=

# Disable framework development/build telemetry for a fully quiet local setup.
NEXT_TELEMETRY_DISABLED=1
