# Ollama runs entirely on your computer and does not charge per token.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# If false, the app uses its built-in deterministic synthetic generator.
ENABLE_LOCAL_AI=true

# Disable framework development/build telemetry for a fully quiet local setup.
NEXT_TELEMETRY_DISABLED=1
